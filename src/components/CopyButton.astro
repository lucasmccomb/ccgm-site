---
/**
 * The one shared copy component every copy surface on the site uses
 * (§1.4 governing context: "one shared CopyButton for every copy surface").
 *
 * Two mutually exclusive modes, chosen by which prop is passed:
 *  - `targetId` (the original mode): copies the exact textContent of the
 *    element with that id. Synchronous, no network.
 *  - `sourceUrl` (§5 E5): fetches that URL at click time and copies the
 *    response body. Used for files the page deliberately does not inline
 *    into the DOM (over the 250 KB page / 64 KB per-file budget, §3.4) --
 *    this keeps a byte-exact copy available without bloating page weight.
 *
 * Either way: announces state changes via an aria-live region and only
 * shows "copied" after the copy resolves; a rejected promise or failed
 * fetch shows an inline error.
 */
interface Props {
  /** id of the element whose textContent gets copied verbatim. Mutually exclusive with sourceUrl. */
  targetId?: string;
  /** URL fetched at click time; its response body is copied verbatim. Mutually exclusive with targetId. */
  sourceUrl?: string;
  /** Human-readable name of what is being copied, used to build aria-label. */
  label: string;
  idleLabel?: string;
  copiedLabel?: string;
  class?: string;
}

const {
  targetId,
  sourceUrl,
  label,
  idleLabel = 'Copy',
  copiedLabel = 'Copied',
  class: className = '',
} = Astro.props;

if (!targetId && !sourceUrl) {
  throw new Error('CopyButton requires either targetId or sourceUrl');
}

// sourceUrl-mode ids are derived from the URL, which may contain slashes and
// dots -- sanitize to a safe id token so the element stays uniquely and
// validly addressable per file.
const idBase = (targetId ?? sourceUrl ?? '').replace(/[^a-zA-Z0-9_-]/g, '-');
const liveId = `copy-live-${idBase}`;
---

<button
  type="button"
  data-copy-button
  data-copy-target={targetId}
  data-copy-source={sourceUrl}
  data-copy-live={liveId}
  data-idle-label={idleLabel}
  data-copied-label={copiedLabel}
  data-error-label="Copy failed"
  data-state="idle"
  aria-label={`Copy ${label}`}
  class={`copy-button ${className}`.trim()}
>
  <span data-copy-label>{idleLabel}</span>
</button>
<span id={liveId} role="status" aria-live="polite" class="sr-only"></span>

<script>
  import '../scripts/copy.ts';
</script>

<style>
  .copy-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-unit);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-1);
    color: var(--color-fg);
    padding: calc(var(--space-unit) * 0.5) var(--space-unit);
    font: inherit;
  }

  .copy-button[data-state='copied'] {
    border-color: var(--color-accent);
  }

  .copy-button[data-state='error'] {
    border-color: #b91c1c;
    color: #b91c1c;
  }
</style>
