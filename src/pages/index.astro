---
/**
 * Landing page (E4). Hero + "what is CCGM" section + stats strip.
 *
 * Stats and the concrete module example are read from the ingested
 * collection (never hand-authored, §1.4 principle 2) -- this page renders
 * correctly whether the build ran against E1's fixture stub (3 modules) or
 * the real ccgm repo (78+ modules, once E2 lands).
 *
 * The hero's headline art is chosen at BUILD time from DEFAULT_THEME
 * (#21), not at runtime: `<html data-theme>` is rendered statically, so
 * the ASCII banner only belongs on the page when ascii is the theme that
 * actually ships. Under any other default the hero renders a quiet
 * lowercase wordmark instead. A `?theme=` review override changes the
 * token layer, never this branch.
 *
 * AsciiArt is used without an explicit `art` prop (E3): it self-loads the
 * build-time-generated banner (scripts/ascii-banner.ts ->
 * src/generated/banner.txt) as its default content.
 *
 * The hero command <pre> carries tabindex="0" for the same reason every
 * other command block on the site does: axe's scrollable-region-focusable
 * rule fires once it overflows horizontally, which it does in the mono
 * theme's 40rem column -- see install.astro, agents.astro,
 * ModuleFileSection.astro.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AsciiArt from '../components/AsciiArt.astro';
import CopyButton from '../components/CopyButton.astro';
import { loadModulesIndex } from '../lib/generated.ts';
import { DEFAULT_THEME } from '../lib/site.ts';
import {
  HERO_TAGLINE,
  INSTALL_COMMAND,
  INSTALL_PATHS_OVERVIEW,
  WHAT_IS_EXAMPLE_LEAD,
  WHAT_IS_HEADING,
  WHAT_IS_INTRO,
  WHAT_IS_MODULE_EXPLANATION,
} from '../lib/pagecopy.ts';

// Same validated single source index.md.ts reads for the same stats --
// a missing/malformed src/generated/modules-index.json fails the build
// loudly instead of silently rendering a zeroed stats strip.
const { meta } = loadModulesIndex();
const moduleCount = meta.moduleCount;
const categoryCount = Object.keys(meta.categories).length;

const modules = await getCollection('modules');
const [exampleModule] = [...modules].sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base
  title="CCGM -- Claude Code God Mode"
  description="A modular Claude Code configuration system. Browse modules, copy install commands, and point an agent at ccgm.dev."
>
  <section class="hero">
    <h1 class="sr-only">CCGM -- Claude Code God Mode</h1>
    {
      DEFAULT_THEME === 'ascii' ? (
        <AsciiArt label="CCGM -- Claude Code God Mode" />
      ) : (
        <p class="hero__wordmark" data-wordmark aria-hidden="true">
          ccgm
        </p>
      )
    }
    <p class="hero__tagline">{HERO_TAGLINE}</p>

    <pre id="install-command" tabindex="0" class="hero__command">{INSTALL_COMMAND}</pre>
    <CopyButton targetId="install-command" label="the install command" />

    <nav class="hero__links" aria-label="Site sections">
      <a href="/install">Install</a>
      <a href="/agents">For agents</a>
      <a href="/modules">Browse modules</a>
      <a href="/rules">Rules</a>
    </nav>
  </section>

  <section class="stats" aria-label="Catalog stats">
    <p>
      <strong data-stat="module-count">{moduleCount}</strong> modules across{' '}
      <strong data-stat="category-count">{categoryCount}</strong> categories.
    </p>
  </section>

  <section class="what-is">
    <h2>{WHAT_IS_HEADING}</h2>
    <p>{WHAT_IS_INTRO}</p>
    <p>{WHAT_IS_MODULE_EXPLANATION}</p>

    <ul class="install-paths" data-install-paths>
      {
        INSTALL_PATHS_OVERVIEW.map((path) => (
          <li>
            <a href={path.href}>{path.name}</a>
            <p>{path.description}</p>
          </li>
        ))
      }
    </ul>

    {
      exampleModule && (
        <div class="example-module" data-example-module>
          <p>{WHAT_IS_EXAMPLE_LEAD}</p>
          <div class="example-module__card">
            <p class="example-module__name">{exampleModule.data.displayName}</p>
            <p>{exampleModule.data.summary}</p>
          </div>
        </div>
      )
    }
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-unit);
  }

  /*
   * The wordmark carries the same job the ASCII banner does under the
   * ascii default -- it is the page's visual headline, with the real
   * heading text living in the sr-only <h1> above it. Decorative, so it
   * is aria-hidden and never read out twice.
   */
  .hero__wordmark {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
  }

  .hero__tagline {
    font-size: 1.125rem;
    color: var(--color-fg);
  }

  .hero__command {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-unit);
    font-family: var(--font-mono);
  }

  /*
   * Wraps because the section list grows. A fourth entry at a 2rem gap no
   * longer fits the mono theme's 40rem column at a 375px viewport, which
   * the standing no-horizontal-overflow check (e2e/themes.spec.ts) reds.
   * Wrapping fixes it once instead of per added link.
   */
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--space-unit) * 0.5) calc(var(--space-unit) * 2);
  }

  .stats {
    margin-top: calc(var(--space-unit) * 2);
  }

  .what-is {
    margin-top: calc(var(--space-unit) * 3);
    display: flex;
    flex-direction: column;
    gap: var(--space-unit);
  }

  /*
   * Hairline rows, not boxes (#21) -- the same treatment ModuleCard.astro
   * gives a catalog row, applied here in the component so every theme
   * gets it and no theme-scoped override is needed. Row separators leave
   * the gap at 0 so the rules themselves set the rhythm.
   */
  .install-paths {
    display: grid;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .install-paths li {
    border-bottom: 1px solid var(--color-border);
    padding: calc(var(--space-unit) * 0.5) 0;
  }

  .example-module__card {
    border-top: 1px solid var(--color-border);
    padding: calc(var(--space-unit) * 0.5) 0 0 0;
  }

  .example-module__name {
    /* A module name is a name, not code -- same reasoning as
       ModuleCard.astro's row name. */
    font-family: var(--font-body);
    font-weight: 500;
  }
</style>
